# ==============================================================================
# LogIQ — env template
# Copy this file to .env.local (frontend) and/or backend/.env (backend),
# then fill in real values.  NEVER commit the copies.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (frontend/.env.local)
# ------------------------------------------------------------------------------
# URL of the FastAPI backend.  Default assumes local dev.
# Vite reads any key prefixed with VITE_ and exposes it as import.meta.env.*
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Backend (backend/.env, optional)
# ------------------------------------------------------------------------------
# If set, enables the Tier-3 LLM fallback in the mapping cascade.
# The parser runs fully without this key — Tier 3 is simply skipped.
# OPENAI_API_KEY=sk-...

# Confidence threshold below which a field is sent to the review queue
# instead of being auto-mapped.  Default 0.70.
# PARSER_CONFIDENCE_THRESHOLD=0.70
